# GEMINI_API_KEY: Required for Gemini AI API calls on the server/worker.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_URL: Public URL of the deployed SpeechCraft API Worker in production.
# Leave empty for local development (uses Express server /api routes).
VITE_GEMINI_API_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
